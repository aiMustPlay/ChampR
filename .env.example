CHAMPR_SERVER_URL=http://127.0.0.1:3030
SERVER_ADDR=0.0.0.0:3030
DATABASE_URL=sqlite://data/champr.db
JWT_SECRET=local-dev-secret-change-me
BOOTSTRAP_ADMIN_EMAIL=admin@local.dev
BOOTSTRAP_ADMIN_PASSWORD=local-admin-1234

# DeepSeek LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_STREAM=false

# Experimental DeepSeek web provider
# CHAMPR_DEEPSEEK_WEB_SIDECAR_PATH=C:\path\to\packages\deepseek-web\dist\main.js
# CHAMPR_DEEPSEEK_WEB_PROFILE=C:\Users\you\AppData\Roaming\champr\deepseek-web-profile

# maohou LLM engine (houmao): empty = auto-locate (sibling checkout -> PATH)
# MAOHOU_BIN=C:\path\to\houmao-mac\engine\target\release\maohou.exe

# Windows TTS
CHAMPR_TTS_RATE=0
CHAMPR_TTS_VOLUME=100
CHAMPR_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Debug: dump raw Live Client / LCU snapshots to .cache/*.json
# CHAMPR_DUMP_SNAPSHOTS=1
