import { VerticalBox, HorizontalBox, ListView, Button, SpinBox, LineEdit, TextEdit, CheckBox, ComboBox } from "std-widgets.slint";

export struct RuneModel {
    /// Display index (for identification in callbacks)
    index: int,
    name: string,
    position: string,
    pick-count: int,
    win-rate: string,
    primary-style-id: int,
    sub-style-id: int,
}

// ---------------------------------------------------------------------------
//  SourcesWindow – source selection, Apply Builds, LCU status
// ---------------------------------------------------------------------------

export component SourcesWindow inherits Window {
    title: "ChampR";
    preferred-width: 520px;
    preferred-height: 720px;

    in-out property <string> status: "loading";
    in-out property <string> lcu-status: "disconnected";
    in-out property <string> lcu-summoner: "";
    in-out property <bool> applying-builds: false;
    in-out property <string> launch-status: "";
    in-out property <bool> lol-running: false;
    in-out property <string> advice-text: "";
    in-out property <string> apply-status: "";
    in-out property <bool> show-lcu-details: false;
    in-out property <bool> show-apply-details: false;
    in-out property <bool> show-launch-details: false;
    in-out property <bool> show-advice-details: false;
    in-out property <bool> apply-ok: false;
    in-out property <bool> launch-ok: false;
    in-out property <bool> llm-assistance-enabled: false;

    callback apply-builds-clicked();
    callback launch-lol-clicked();
    callback open-tts-settings-clicked();
    callback llm-assistance-changed(bool);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e2e8f0;
            horizontal-stretch: 1;

            VerticalBox {
                padding: 12px;
                spacing: 10px;

                Text {
                    text: "Status";
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    height: 32px;

                    Text {
                        text: "LCU 🎮";
                        font-size: 14px;
                        vertical-alignment: center;
                        width: 120px;
                    }
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.lcu-status == "connected" ? #22aa55 : #d64545;
                    }
                    Button {
                        text: root.lcu-status == "connected" ? "ℹ️" : "❗";
                        width: 28px;
                        height: 28px;
                        clicked => {
                            root.show-lcu-details = !root.show-lcu-details;
                        }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    height: 32px;

                    Text {
                        text: "LoL 🚀";
                        font-size: 14px;
                        vertical-alignment: center;
                        width: 120px;
                    }
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.launch-ok ? #22aa55 : (root.launch-status != "" ? #d64545 : #8a94a6);
                    }
                    Button {
                        text: root.launch-ok ? "ℹ️" : "❗";
                        width: 28px;
                        height: 28px;
                        enabled: root.launch-status != "";
                        clicked => {
                            root.show-launch-details = !root.show-launch-details;
                        }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    height: 32px;

                    Text {
                        text: "Builds 🛠️";
                        font-size: 14px;
                        vertical-alignment: center;
                        width: 120px;
                    }
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.apply-ok ? #22aa55 : (root.apply-status != "" ? #d64545 : #8a94a6);
                    }
                    Button {
                        text: root.apply-ok ? "ℹ️" : "❗";
                        width: 28px;
                        height: 28px;
                        enabled: root.apply-status != "";
                        clicked => {
                            root.show-apply-details = !root.show-apply-details;
                        }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    height: 32px;

                    Text {
                        text: "Advice 🧠";
                        font-size: 14px;
                        vertical-alignment: center;
                        width: 120px;
                    }
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.advice-text != "" ? #22aa55 : #8a94a6;
                    }
                    Button {
                        text: "ℹ️";
                        width: 28px;
                        height: 28px;
                        enabled: root.advice-text != "";
                        clicked => {
                            root.show-advice-details = !root.show-advice-details;
                        }
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e2e8f0;
            horizontal-stretch: 1;

            VerticalBox {
                padding: 12px;
                spacing: 10px;

                Text {
                    text: "Actions";
                    font-size: 15px;
                    font-weight: 600;
                }

                CheckBox {
                    text: "大师对局辅助";
                    checked: root.llm-assistance-enabled;
                    toggled => {
                        root.llm-assistance-enabled = !root.llm-assistance-enabled;
                        root.llm-assistance-changed(root.llm-assistance-enabled);
                    }
                }

                Button {
                    text: "🚀 启动 LoL";
                    height: 36px;
                    horizontal-stretch: 1;
                    enabled: !root.lol-running;
                    clicked => {
                        root.launch-lol-clicked();
                    }
                }

                Button {
                    text: "🛠 Apply Builds";
                    height: 36px;
                    horizontal-stretch: 1;
                    enabled: !root.applying-builds && root.lcu-status == "connected";
                    clicked => {
                        root.apply-builds-clicked();
                    }
                }

                Button {
                    text: "🎛 Settings";
                    height: 36px;
                    horizontal-stretch: 1;
                    clicked => {
                        root.open-tts-settings-clicked();
                    }
                }
            }
        }

        Text {
            text: "Details";
            font-size: 15px;
            font-weight: 600;
        }

        if root.show-lcu-details : TextEdit {
            text: root.lcu-status == "connected"
                ? "League Client: " + root.lcu-summoner
                : root.lcu-status == "authorizing"
                ? "League Client detected. Requesting admin access..."
                : root.lcu-status == "needs-admin"
                ? "League Client detected. Admin access is required once to read LCU credentials."
                : "League Client not detected";
            font-size: 12px;
            read-only: true;
        }

        if root.show-launch-details && root.launch-status != "" : TextEdit {
            text: root.launch-status;
            font-size: 12px;
            read-only: true;
        }

        if root.show-apply-details && root.apply-status != "" : TextEdit {
            text: root.apply-status;
            font-size: 12px;
            read-only: true;
        }

        if root.show-advice-details && root.advice-text != "" : TextEdit {
            text: root.advice-text;
            font-size: 12px;
            read-only: true;
        }
    }
}
export component TtsSettingsWindow inherits Window {
    title: "Settings";
    preferred-width: 480px;
    preferred-height: 760px;

    in-out property <int> tts-rate: 0;
    in-out property <int> tts-volume: 100;
    in-out property <string> tts-voice: "zh-CN-XiaoxiaoNeural";
    in-out property <string> tts-test-text: "";
    in-out property <string> tts-test-status: "";
    in-out property <string> lol-launcher-path: "";
    in-out property <string> deepseek-api-key: "";
    in-out property <string> deepseek-base-url: "";
    in-out property <string> deepseek-model: "";
    in-out property <bool> deepseek-thinking: false;
    in-out property <bool> deepseek-stream: false;
    in-out property <string> deepseek-reasoning-effort: "";
    in-out property <string> ai-provider: "deepseek";
    in-out property <string> lmstudio-base-url: "http://localhost:1234/v1";
    in-out property <string> lmstudio-model: "local-model";
    in-out property <string> lmstudio-api-key: "";

    callback apply-clicked();
    callback cancel-clicked();
    callback test-tts-clicked();
    callback open-speech-settings-clicked();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Settings";
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e2e8f0;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 12px;
                spacing: 10px;
                Text { text: "TTS"; font-size: 15px; font-weight: 600; }
                HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Rate"; width: 110px; vertical-alignment: center; }
                    SpinBox { minimum: -10; maximum: 10; value: root.tts-rate; horizontal-stretch: 1; edited(value) => { root.tts-rate = value; } }
                }
                HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Volume"; width: 110px; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 100; value: root.tts-volume; horizontal-stretch: 1; edited(value) => { root.tts-volume = value; } }
                }
                HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Voice"; width: 110px; vertical-alignment: center; }
                    LineEdit { text: root.tts-voice; horizontal-stretch: 1; edited(text) => { root.tts-voice = text; } }
                }
                HorizontalBox { height: 40px; spacing: 12px;
                    LineEdit { text: root.tts-test-text; placeholder-text: "输入测试文字"; horizontal-stretch: 1; edited(text) => { root.tts-test-text = text; } }
                    Button { text: "🔊 Test"; clicked => { root.test-tts-clicked(); } }
                }
                if root.tts-test-status != "" : TextEdit {
                    text: root.tts-test-status;
                    font-size: 12px;
                    read-only: true;
                }
                Button {
                    text: "打开语音设置";
                    horizontal-stretch: 1;
                    clicked => {
                        root.open-speech-settings-clicked();
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e2e8f0;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 12px;
                spacing: 10px;
                Text { text: "LoL"; font-size: 15px; font-weight: 600; }
                HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Launcher"; width: 110px; vertical-alignment: center; }
                    LineEdit { text: root.lol-launcher-path; horizontal-stretch: 1; edited(text) => { root.lol-launcher-path = text; } }
                }
            }
        }

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e2e8f0;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 12px;
                spacing: 10px;
                Text { text: "DeepSeek"; font-size: 15px; font-weight: 600; }
                HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Provider"; width: 110px; vertical-alignment: center; }
                    ComboBox {
                        model: ["deepseek", "lmstudio"];
                        current-value: root.ai-provider;
                        selected(value) => {
                            root.ai-provider = value;
                        }
                    }
                }
                if root.ai-provider == "deepseek" : VerticalBox {
                    spacing: 10px;
                    HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "API Key"; width: 110px; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-api-key; horizontal-stretch: 1; edited(text) => { root.deepseek-api-key = text; } }
                    }
                    HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Model"; width: 110px; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-model; horizontal-stretch: 1; edited(text) => { root.deepseek-model = text; } }
                    }
                    HorizontalBox { height: 32px; spacing: 12px;
                    Text { text: "Thinking"; width: 110px; vertical-alignment: center; }
                    CheckBox { checked: root.deepseek-thinking; toggled => { root.deepseek-thinking = !root.deepseek-thinking; } }
                    }
                    HorizontalBox { height: 32px; spacing: 12px;
                    Text { text: "Stream"; width: 110px; vertical-alignment: center; }
                    CheckBox { checked: root.deepseek-stream; toggled => { root.deepseek-stream = !root.deepseek-stream; } }
                    }
                    HorizontalBox { height: 40px; spacing: 12px;
                    Text { text: "Reasoning"; width: 110px; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-reasoning-effort; horizontal-stretch: 1; edited(text) => { root.deepseek-reasoning-effort = text; } }
                    }
                }
                if root.ai-provider == "lmstudio" : VerticalBox {
                    spacing: 10px;
                    HorizontalBox { height: 40px; spacing: 12px;
                        Text { text: "Base URL"; width: 110px; vertical-alignment: center; }
                        LineEdit { text: root.lmstudio-base-url; horizontal-stretch: 1; edited(text) => { root.lmstudio-base-url = text; } }
                    }
                    HorizontalBox { height: 40px; spacing: 12px;
                        Text { text: "Model"; width: 110px; vertical-alignment: center; }
                        LineEdit { text: root.lmstudio-model; horizontal-stretch: 1; edited(text) => { root.lmstudio-model = text; } }
                    }
                    HorizontalBox { height: 40px; spacing: 12px;
                        Text { text: "API Key"; width: 110px; vertical-alignment: center; }
                        LineEdit { text: root.lmstudio-api-key; horizontal-stretch: 1; edited(text) => { root.lmstudio-api-key = text; } }
                    }
                }
            }
        }

        HorizontalBox {
            alignment: end;
            spacing: 12px;
            Button { text: "Cancel"; clicked => { root.cancel-clicked(); } }
            Button { text: "Apply"; clicked => { root.apply-clicked(); } }
        }
    }
}
export component RunesWindow inherits Window {
    title: "Runes";
    preferred-width: 500px;
    preferred-height: 640px;

    // --- properties ---
    in-out property <int> champion-id: 0;
    in-out property <string> champion-name: "";
    in-out property <image> champion-avatar;
    in-out property <bool> has-champion: false;
    in-out property <[RuneModel]> runes;
    in-out property <string> rune-status: "";  // "" | "loading" | "error" | "success"
    in-out property <string> apply-rune-status: "";

    // --- callbacks ---
    callback close-requested();
    callback apply-rune-clicked(int);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Champion header
        if root.has-champion : HorizontalBox {
            spacing: 12px;
            alignment: center;

            Image {
                source: root.champion-avatar;
                width: 64px;
                height: 64px;
            }

            VerticalBox {
                alignment: center;
                TextEdit {
                    text: root.champion-name != "" ? root.champion-name : "Champion " + root.champion-id;
                    font-size: 22px;
                    read-only: true;
                }
            }
        }

        if root.has-champion : HorizontalBox {
            spacing: 8px;
            alignment: center;

            Text {
                text: "Source:";
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: "OP.GG";
                font-size: 14px;
                color: #666666;
            }
        }

        // Rune list
        if root.rune-status == "loading" : Text {
            text: "Loading runes…";
            font-size: 14px;
            horizontal-alignment: center;
            color: #888888;
        }

        if root.rune-status == "error" : Text {
            text: "Failed to load runes for this champion.";
            font-size: 14px;
            horizontal-alignment: center;
            color: #cc3333;
        }

        if root.rune-status == "success" : ListView {
            for rune[index] in root.runes : Rectangle {
                border-width: 1px;
                border-color: #dddddd;
                border-radius: 6px;
                background: #fafafa;
                height: 72px;

                HorizontalBox {
                    padding: 8px;
                    spacing: 8px;
                    alignment: stretch;

                    VerticalBox {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: rune.name != "" ? rune.name : rune.position;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Text {
                                text: "Picks: " + rune.pick-count;
                                font-size: 12px;
                                color: #666666;
                            }
                            Text {
                                text: "WR: " + rune.win-rate;
                                font-size: 12px;
                                color: #666666;
                            }
                        }

                        Text {
                            text: rune.position;
                            font-size: 11px;
                            color: #999999;
                        }
                    }

                    VerticalBox {
                        alignment: center;
                        Button {
                            text: "Apply";
                            clicked => {
                                root.apply-rune-clicked(rune.index);
                            }
                        }
                    }
                }
            }
        }

        // Apply rune feedback
        if root.apply-rune-status != "" : Text {
            text: root.apply-rune-status;
            font-size: 13px;
            horizontal-alignment: center;
            color: #666666;
        }

        // Close
        HorizontalBox {
            alignment: center;
            Button {
                text: "Close";
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
