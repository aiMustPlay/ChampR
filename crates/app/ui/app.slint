// 用 HorizontalLayout/VerticalLayout 而不是 HorizontalLayout/VerticalLayout:
// 后者 = 布局 + StyleMetrics.layout-padding(8px), 会给每行偷偷加 8px 内边距,
// 造成行与行对不齐(2026-10-03 用户指出的 Tab 行比文本框右移 8px)。内边距一律显式写。
import { ListView, ScrollView, SpinBox, LineEdit, TextEdit, ComboBox, Palette } from "std-widgets.slint";

// 把风格内置的 Palette 再导出, 让 Rust 端能拿到句柄:
//   Palette.color-scheme 是 in-out 且双向绑到 FluentPalette.color-scheme,
//   启动时 set_color_scheme(Dark) 就能把 TextEdit/LineEdit/ComboBox
//   这些不吃 Tokens 的控件一起翻到深色(它们跟随 OS 主题, 只能这样强制)。
export { Palette } from "std-widgets.slint";

// ---------------------------------------------------------------------------
//  Design tokens —— 全局统一尺寸/颜色, 对齐 analysis_and_design/ui-design-system.md
//  修改窗口样式只改这里, 不要在组件里散落魔法数字。
// ---------------------------------------------------------------------------

export global Tokens {
    // 全局字体: Slint 默认字体回退渲染中文很糟, 统一微软雅黑 UI。
    out property <string> font-family: "Microsoft YaHei UI";
    // spacing scale (8pt grid, 4px 起步)
    out property <length> s-xs: 4px;
    out property <length> s-sm: 8px;
    out property <length> s-md: 12px;
    out property <length> s-lg: 16px;
    out property <length> s-xl: 24px;

    // chrome
    out property <length> radius: 8px;
    out property <length> status-dot: 8px;
    out property <length> row-height: 32px;
    out property <length> icon-btn: 28px;
    out property <length> btn-height: 36px;

    // typography
    out property <length> f-title: 22px;
    out property <length> f-section: 15px;
    out property <length> f-body: 14px;
    out property <length> f-aux: 12px;
    out property <length> f-mini: 11px;

    // 状态色(深色底上提高对比)
    out property <color> c-ok: #3fbf6f;
    out property <color> c-warn: #e6a817;
    out property <color> c-err: #e2604f;
    out property <color> c-muted: #8a94a6;

    // ---- 统一深金(Hextech)配色 ----
    // 用户 2026-10-03 拍板: 主窗/设置/符文/迷你全部同一套, 不再分"工具风/游戏风"。
    // 改配色只改这一段; 窗口内的 TextEdit/CheckBox/ComboBox 由各窗 Palette 覆写
    // 带进深色(见各 Window 顶部的 Palette 块)。
    out property <color> c-page: #0e1628;          // 窗口底
    out property <color> c-card: #16233a;          // 卡片面
    out property <color> c-card-border: #2a3b55;   // 卡片描边
    out property <color> c-text: #e8eef6;          // 主文字
    out property <color> c-text-secondary: #9fb3c8;
    out property <color> c-text-faint: #6f8299;
    out property <color> c-gold: #c89b3c;          // 主题强调(Hextech 金)

    // Counter/心战类强调卡
    out property <color> c-accent-bg: #241d10;
    out property <color> c-accent-border: #6b5527;
    out property <color> c-accent-title: #d9c78e;
    out property <color> c-accent-text: #d9c78e;

    // 表单行高(Settings 输入行, 比状态行高一点)
    out property <length> row-field: 40px;

    // 描边与焦点
    out property <length> border-hair: 1px;

    // 补充色
    out property <color> c-warn-text: #e6a817;

    // 布局件固定占位(有意固定, 语义命名)
    out property <length> w-status-label: 120px;
    out property <length> w-form-label: 110px;
    out property <length> w-tier-combo: 150px;
    out property <length> avatar: 64px;
    out property <length> row-rune-item: 72px;
    out property <length> panel-match-h: 210px;
    out property <length> panel-log-h: 340px;

    // 窗口尺寸: 统一黄金比 1.618 (用户 2026-10-03 拍板"按黄金比例、比现在大 2 倍")
    // 主窗 830×1343: 黄金比下 100% 缩放(2560×1440, 工作区高 1392)能"连外框一起"
    // 完整放下的尺寸; 更大的数值会被 place_window_in_work_area 自动缩回。
    out property <length> win-main-w: 830px;
    out property <length> win-main-h: 1343px;
    out property <length> win-main-min-w: 620px;
    out property <length> win-main-min-h: 1003px;
    out property <length> win-runes-w: 720px;
    out property <length> win-runes-h: 1165px;
    out property <length> win-runes-min-w: 560px;
    out property <length> win-runes-min-h: 906px;
    out property <length> win-settings-w: 560px;
    out property <length> win-settings-h: 906px;
    out property <length> win-settings-min-w: 480px;
    out property <length> win-settings-min-h: 777px;
    out property <length> win-mini-w: 340px;
    out property <length> win-mini-h: 240px;
}

// ---------------------------------------------------------------------------
//  自绘控件: Slint Fluent 风格的强调色是系统蓝, 无法改(accent-* 是只读属性),
//  要让主题统一成 Hextech 金, 只能自己画按钮与勾选框。
//  接口刻意与 std-widgets 同名(text/enabled/primary/clicked 与
//  text/checked/toggled), 这样调用点替换是机械的。
// ---------------------------------------------------------------------------
component GoldButton inherits Rectangle {
    in property <string> text: "";
    /// 主按钮: 金底深字(用于"当前 Tab / 主操作")
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: Tokens.btn-height;
    border-radius: Tokens.radius;
    border-width: Tokens.border-hair;
    border-color: !enabled ? Tokens.c-card-border : (primary ? Tokens.c-gold : Tokens.c-card-border);
    background: !enabled ? Tokens.c-card
        : primary ? (touch.pressed ? Tokens.c-gold.darker(0.18) : (touch.has-hover ? Tokens.c-gold.brighter(0.08) : Tokens.c-gold))
        : (touch.pressed ? Tokens.c-card.darker(0.25) : (touch.has-hover ? Tokens.c-card.brighter(0.12) : Tokens.c-card));

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        font-size: Tokens.f-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.enabled ? Tokens.c-text-faint
            : (root.primary ? Tokens.c-page : Tokens.c-text);
    }
}

component GoldCheck inherits HorizontalLayout {
    in property <string> text: "";
    in-out property <bool> checked: false;
    callback toggled(bool);

    spacing: 0;
    Rectangle {
        height: Tokens.row-height;
        width: inner.preferred-width;
        horizontal-stretch: 0;
        background: transparent;

        inner := HorizontalLayout {
            spacing: Tokens.s-xs;
            alignment: center;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                border-width: Tokens.border-hair;
                border-color: root.checked ? Tokens.c-gold : Tokens.c-text-faint;
                background: root.checked ? Tokens.c-gold : Tokens.c-card;

                Text {
                    text: "✓";
                    font-size: Tokens.f-mini;
                    color: Tokens.c-page;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    visible: root.checked;
                }
            }

            Text {
                text: root.text;
                font-size: Tokens.f-body;
                color: Tokens.c-text;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

export struct RuneModel {
    /// Display index (for identification in callbacks)
    index: int,
    name: string,
    position: string,
    pick-count: int,
    win-rate: string,
    primary-style-id: int,
    sub-style-id: int,
}
// ---------------------------------------------------------------------------
//  RunesPanel —— 选人 + 符文面板。
//  原先是独立弹出的「符文窗」, 2026-10-04 用户拍板并入主窗, 作为「符文」Tab 的内容:
//  一个主窗、一次选符文、一句提醒, 不再维护第二套窗口生命周期。
//  内容较长, 整页可滚。
// ---------------------------------------------------------------------------
component RunesPanel inherits ScrollView {
    viewport-width: self.width;

    // --- properties (由主窗透传) ---
    in-out property <int> champion-id: 0;
    in-out property <string> champion-name: "";
    in-out property <image> champion-avatar;
    in-out property <bool> has-champion: false;
    in-out property <[RuneModel]> runes;
    in-out property <string> rune-status: "";  // "" | "loading" | "error" | "success"
    in-out property <string> apply-rune-status: "";
    in-out property <string> position-label: "";   // 本局分路, e.g. "中单"
    in-out property <bool> auto-apply-enabled: false;
    in-out property <bool> auto-builds-enabled: false;
    // Local counter-rule rune plan for the current lane matchup.
    in-out property <bool> counter-available: false;
    in-out property <string> counter-summary: "";
    // 没有方案时必给出的原因(反静默失败), 有方案时为空。
    in-out property <string> counter-status: "";
    // 对位心理卡(DDragon allytips/enemytips): 对面已选出对位英雄即显示
    in-out property <string> opponent-header: "";
    in-out property <string> opponent-intel: "";
    // 兵法心战卡(战略两层 + 战术压力档): 敌我均选即可显示
    in-out property <string> war-header: "";
    in-out property <string> war-body: "";
    // 符文对比卡(我方 vs 对方符文特性 + 扬长避短提醒)
    in-out property <string> rune-compare-header: "";
    in-out property <string> rune-compare-body: "";
    // 选人排面: 我方/敌方 1~5楼 + 分路 + 已选英雄(每次选人更新都刷)
    in-out property <string> roster-my: "";
    in-out property <string> roster-enemy: "";
    // Counter 手动对位候选: 敌方已选/悬停英雄(id 与中文名平行数组)
    in-out property <[int]> counter-cand-ids: [];
    in-out property <[string]> counter-cand-names: [];

    // --- callbacks (转发给主窗) ---
    callback apply-rune-clicked(int);
    callback apply-best-rune-clicked();
    callback apply-counter-rune-clicked();
    callback auto-apply-toggled(bool);
    callback auto-builds-toggled(bool);
    // 手动点选对位英雄 id(敌方已锁)
    callback counter-pick-opponent(int);

        VerticalLayout {
            padding: Tokens.s-md;
            spacing: Tokens.s-md;

            // 选人排面(我方/敌方 1~5楼 分路 英雄)
            if root.roster-my != "" : Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-gold;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Tokens.s-sm;
                spacing: 4px;
                Text {
                    text: root.roster-my;
                    font-size: Tokens.f-mini;
                    color: Tokens.c-gold;
                    wrap: word-wrap;
                }
                Text {
                    text: root.roster-enemy;
                    font-size: Tokens.f-mini;
                    color: Tokens.c-text-faint;
                    wrap: word-wrap;
                }
            }
        }

        // Champion header
        if root.has-champion : HorizontalLayout {
            spacing: Tokens.s-md;
            alignment: center;

            Image {
                source: root.champion-avatar;
                width: Tokens.avatar;
                height: Tokens.avatar;
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.champion-name != "" ? root.champion-name : "Champion " + root.champion-id;
                    font-size: Tokens.f-title;
                    font-weight: 700;
                    color: Tokens.c-gold;
                    overflow: elide;
                }
            }
        }

        if root.has-champion : HorizontalLayout {
            spacing: Tokens.s-sm;
            // 靠左对齐, 与上方英雄名/下方按钮同一条左边线
            alignment: start;

            Text {
                text: "本局分路: " + (root.position-label != "" ? root.position-label : "未知") + " · 数据源 OP.GG";
                font-size: Tokens.f-body;
                color: Tokens.c-text;
                vertical-alignment: center;
            }
        }

        // Matchup-targeted rune actions: counter plan is the primary action
        // whenever the local rule engine has one; mainstream-only otherwise.
        if root.has-champion : HorizontalLayout {
            spacing: Tokens.s-sm;

            GoldButton {
                text: "应用 Counter 符文";
                primary: root.counter-available;
                enabled: root.counter-available;
                horizontal-stretch: 1;
                clicked => {
                    root.apply-counter-rune-clicked();
                }
            }
            GoldButton {
                text: "应用主流最优符文";
                primary: !root.counter-available;
                horizontal-stretch: 1;
                clicked => {
                    root.apply-best-rune-clicked();
                }
            }
        }

        if root.has-champion : HorizontalLayout {
            spacing: Tokens.s-lg;
            alignment: center;

            // 自绘 GoldCheck 能画标签了, 不再需要"空 CheckBox + 外部 Text"的旧补丁
            GoldCheck {
                text: "锁后自动符文";
                checked <=> root.auto-apply-enabled;
                toggled => {
                    root.auto-apply-toggled(root.auto-apply-enabled);
                }
            }
            GoldCheck {
                text: "锁后自动出装";
                checked <=> root.auto-builds-enabled;
                toggled => {
                    root.auto-builds-toggled(root.auto-builds-enabled);
                }
            }
        }

        // Counter plan card: summary + reason when available, explicit hint
        // when not (previously the button went gray with no explanation).
        if root.has-champion : Rectangle {
            background: Tokens.c-accent-bg;
            border-color: Tokens.c-gold;
            border-width: Tokens.border-hair;
            border-radius: Tokens.radius;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: Tokens.s-sm;
                spacing: Tokens.s-xs;

                Text {
                    text: "Counter 符文(本地规则, 按对位与敌方类型调整)";
                    font-size: Tokens.f-aux;
                    font-weight: 600;
                    color: Tokens.c-gold;
                }
                if root.counter-available : Text {
                    text: root.counter-summary;
                    font-size: Tokens.f-aux;
                    color: Tokens.c-accent-text;
                    wrap: word-wrap;
                }
                if !root.counter-available : Text {
                    text: root.counter-status != ""
                        ? "暂无: " + root.counter-status
                        : "悬停英雄后, 等对面选出对位即给出方案";
                    font-size: Tokens.f-aux;
                    color: Tokens.c-muted;
                    wrap: word-wrap;
                }
                // 手动对位兜底: 自动认不到对位时, 直接点"我这局打谁"
                if !root.counter-available && root.counter-cand-names.length > 0 : VerticalLayout {
                    spacing: Tokens.s-xs;
                    Text {
                        text: "对位没自动认到? 点你打的人:";
                        font-size: Tokens.f-aux;
                        color: Tokens.c-gold;
                    }
                    HorizontalLayout {
                        spacing: Tokens.s-xs;
                        alignment: start;
                        for name[i] in root.counter-cand-names : Rectangle {
                            height: 26px;
                            width: chip-text.preferred-width + Tokens.s-md * 2;
                            background: cand-touch.has-hover ? Tokens.c-gold : Tokens.c-card;
                            border-radius: Tokens.radius;
                            border-color: Tokens.c-gold;
                            border-width: Tokens.border-hair;
                            cand-touch := TouchArea {
                                clicked => { root.counter-pick-opponent(root.counter-cand-ids[i]); }
                            }
                            chip-text := Text {
                                text: name;
                                font-size: Tokens.f-aux;
                                // hover 时底变金, 字要转深色才看得清
                                color: cand-touch.has-hover ? Tokens.c-page : Tokens.c-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 符文对比卡: 我方 vs 对方符文特性 + 扬长避短(对局内才有, 对方符文开局才公开)
        if root.rune-compare-body != "" : Rectangle {
            background: Tokens.c-card;
            border-color: Tokens.c-gold;
            border-width: Tokens.border-hair;
            border-radius: Tokens.radius;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: Tokens.s-sm;
                spacing: Tokens.s-xs;

                Text {
                    text: root.rune-compare-header;
                    font-size: Tokens.f-aux;
                    font-weight: 600;
                    color: Tokens.c-gold;
                }
                Text {
                    text: root.rune-compare-body;
                    font-size: Tokens.f-aux;
                    color: Tokens.c-text;
                    wrap: word-wrap;
                }
            }
        }

        // 对位心理卡: 意图(他想)+弱点(打他), 立于 counter 符文卡之下
        if root.has-champion && root.opponent-intel != "" : Rectangle {
            background: Tokens.c-card;
            border-color: Tokens.c-card-border;
            border-width: Tokens.border-hair;
            border-radius: Tokens.radius;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: Tokens.s-sm;
                spacing: Tokens.s-xs;

                Text {
                    text: root.opponent-header;
                    font-size: Tokens.f-aux;
                    font-weight: 600;
                    color: Tokens.c-gold;
                }
                Text {
                    text: root.opponent-intel;
                    font-size: Tokens.f-aux;
                    color: Tokens.c-text;
                    wrap: word-wrap;
                }
            }
        }

        // 兵法心战卡: 战略(双方分型) + 敌方心理/连招 + 战术(压力档)
        if root.has-champion && root.war-body != "" : Rectangle {
            background: Tokens.c-accent-bg;
            border-color: Tokens.c-card-border;
            border-width: Tokens.border-hair;
            border-radius: Tokens.radius;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: Tokens.s-sm;
                spacing: Tokens.s-xs;

                Text {
                    text: root.war-header;
                    font-size: Tokens.f-aux;
                    font-weight: 600;
                    color: Tokens.c-gold;
                }
                Text {
                    text: root.war-body;
                    font-size: Tokens.f-aux;
                    color: Tokens.c-text;
                    wrap: word-wrap;
                }
            }
        }

        if !root.has-champion : Text {
            text: "进入英雄选择后自动展示符文页";
            font-size: Tokens.f-body;
            horizontal-alignment: center;
            color: Tokens.c-muted;
        }

        // Rune list
        if root.rune-status == "loading" : Text {
            text: "符文加载中…";
            font-size: Tokens.f-body;
            horizontal-alignment: center;
            color: Tokens.c-muted;
        }

        if root.rune-status == "error" : Text {
            text: "符文数据加载失败";
            font-size: Tokens.f-body;
            horizontal-alignment: center;
            color: Tokens.c-err;
        }

        if root.rune-status == "success" : VerticalLayout {
            spacing: Tokens.s-xs;
            for rune[index] in root.runes : Rectangle {
                border-width: Tokens.border-hair;
                border-color: Tokens.c-card-border;
                border-radius: Tokens.radius;
                background: Tokens.c-card;
                height: Tokens.row-rune-item;

                HorizontalLayout {
                    padding: Tokens.s-sm;
                    spacing: Tokens.s-sm;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        spacing: Tokens.s-xs;

                        Text {
                            text: rune.name != "" ? rune.name : rune.position;
                            font-size: Tokens.f-body;
                            font-weight: 600;
                            color: Tokens.c-text;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: Tokens.s-md;
                            Text {
                                text: "选用: " + rune.pick-count;
                                font-size: Tokens.f-aux;
                                color: Tokens.c-text-secondary;
                            }
                            Text {
                                text: "胜率: " + rune.win-rate;
                                font-size: Tokens.f-aux;
                                color: Tokens.c-text-secondary;
                            }
                        }

                        Text {
                            text: rune.position;
                            font-size: Tokens.f-mini;
                            color: Tokens.c-text-secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        GoldButton {
                            text: "应用";
                            clicked => {
                                root.apply-rune-clicked(rune.index);
                            }
                        }
                    }
                }
            }
        }

        // Apply rune feedback
        if root.apply-rune-status != "" : Text {
            text: root.apply-rune-status;
            font-size: Tokens.f-aux;
            horizontal-alignment: center;
            color: Tokens.c-text-secondary;
        }
    }
}

// ---------------------------------------------------------------------------
//  SourcesWindow – source selection, Apply Builds, LCU status
// ---------------------------------------------------------------------------

export component SourcesWindow inherits Window {
    default-font-family: Tokens.font-family;
    icon: @image-url("icons/champr.png");
    title: "ChampR";
    preferred-width: Tokens.win-main-w;
    preferred-height: Tokens.win-main-h;
    min-width: Tokens.win-main-min-w;
    min-height: Tokens.win-main-min-h;
    background: Tokens.c-page;

    in-out property <string> status: "loading";
    in-out property <string> lcu-status: "disconnected";
    in-out property <string> lcu-summoner: "";
    in-out property <bool> llm-assistance-enabled: false;
    in-out property <int> reminder-tier: 0;
    in-out property <string> match-session-status: "等待对局";
    in-out property <string> coach-chat-log: "";
    in-out property <string> coach-input: "";
    in-out property <bool> coach-busy: false;
    in-out property <string> live-match-text: "";
    in-out property <bool> mini-live-enabled: true;
    // 输出区当前 Tab: 0 = 符文, 1 = 对局数据, 2 = 大师对话(谁刚输出谁上前台)
    in-out property <int> output-tab: 0;
    // 构建戳(git 短 hash + 是否有未提交改动), 由 Rust 启动时注入
    in-out property <string> build-stamp: "";

    // ---- 符书面板属性(原独立符文窗, 现由主窗持有并透传给 RunesPanel) ----
    in-out property <int> champion-id: 0;
    in-out property <string> champion-name: "";
    in-out property <image> champion-avatar;
    in-out property <bool> has-champion: false;
    in-out property <[RuneModel]> runes;
    in-out property <string> rune-status: "";  // "" | "loading" | "error" | "success"
    in-out property <string> apply-rune-status: "";
    in-out property <string> position-label: "";
    in-out property <bool> auto-apply-enabled: false;
    in-out property <bool> auto-builds-enabled: false;
    in-out property <bool> counter-available: false;
    in-out property <string> counter-summary: "";
    in-out property <string> counter-status: "";
    in-out property <string> opponent-header: "";
    in-out property <string> opponent-intel: "";
    in-out property <string> war-header: "";
    in-out property <string> war-body: "";
    // 符文对比卡: 我方 vs 对方符文特性 + 扬长避短提醒(言简意赅)
    in-out property <string> rune-compare-header: "";
    in-out property <string> rune-compare-body: "";
    in-out property <string> roster-my: "";
    in-out property <string> roster-enemy: "";
    in-out property <[int]> counter-cand-ids: [];
    in-out property <[string]> counter-cand-names: [];

    callback open-tts-settings-clicked();
    callback llm-assistance-changed(bool);
    callback reminder-tier-changed(int);
    callback coach-send-clicked();
    callback mini-live-toggled(bool);
    // 手动切输出 Tab(调用方记录时间, 45 秒内暂停自动跟随)
    callback output-tab-clicked(int);
    // 正在输入时续期静默(不许对局快照把输入框抢走)
    callback output-tab-hold();
    // ---- 符文面板回调(主窗实现, RunesPanel 转发) ----
    callback apply-rune-clicked(int);
    callback apply-best-rune-clicked();
    callback apply-counter-rune-clicked();
    callback auto-apply-toggled(bool);
    callback auto-builds-toggled(bool);
    callback counter-pick-opponent(int);

    VerticalLayout {
        padding: Tokens.s-lg;
        spacing: Tokens.s-md;

        // 反静默: LCU 未连接时把原因说在明面上(不摆状态灯, 但灰按钮要有解释)
        if root.lcu-status != "connected" : Text {
            text: "LCU 未连接: 启动并登入 LoL 客户端后自动接入(细节见控制台日志)";
            font-size: Tokens.f-mini;
            color: Tokens.c-text-faint;
            wrap: word-wrap;
        }

        // 单一内容区(用户 2026-10-04 拍板): 符文 / 对局数据 / 大师对话 三个 Tab 同住
        // 一个主窗, 谁刚出新内容谁上前台; 手动点过 Tab 后 45 秒内不被自动抢台。
        // 余量归属: 内容区 vertical-stretch 吃掉卡片内余量(没有认领者时 Slint 会把
        // 余量塞在子元素之间形成空白 —— 2026-10-03 踩过)。
        Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-card-border;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                padding: Tokens.s-md;
                spacing: Tokens.s-sm;

                HorizontalLayout {
                    spacing: Tokens.s-xs;
                    // 不写 alignment: center —— 那会让整行内容居中, Tab 左边缘
                    // 与下面的内容对不齐(2026-10-03 用户指出的问题)。
                    height: Tokens.btn-height;

                    GoldButton {
                        text: "符文";
                        primary: root.output-tab == 0;
                        height: Tokens.btn-height;
                        min-width: 88px;
                        clicked => {
                            root.output-tab = 0;
                            root.output-tab-clicked(0);
                        }
                    }
                    GoldButton {
                        text: "对局数据";
                        primary: root.output-tab == 1;
                        height: Tokens.btn-height;
                        min-width: 104px;
                        clicked => {
                            root.output-tab = 1;
                            root.output-tab-clicked(1);
                        }
                    }
                    GoldButton {
                        text: "大师对话";
                        primary: root.output-tab == 2;
                        height: Tokens.btn-height;
                        min-width: 104px;
                        clicked => {
                            root.output-tab = 2;
                            root.output-tab-clicked(2);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                    }
                    if root.output-tab == 1 : GoldCheck {
                        text: "开局弹迷你窗";
                        checked: root.mini-live-enabled;
                        toggled => {
                            root.mini-live-enabled = !root.mini-live-enabled;
                            root.mini-live-toggled(root.mini-live-enabled);
                        }
                    }
                    if root.output-tab == 2 : Text {
                        text: root.match-session-status;
                        font-size: Tokens.f-aux;
                        vertical-alignment: center;
                        color: Tokens.c-text-secondary;
                    }
                    if root.output-tab == 2 : GoldCheck {
                        text: "大师对局辅助";
                        checked: root.llm-assistance-enabled;
                        toggled => {
                            root.llm-assistance-enabled = !root.llm-assistance-enabled;
                            root.llm-assistance-changed(root.llm-assistance-enabled);
                        }
                    }
                    if root.output-tab == 2 : ComboBox {
                        width: Tokens.w-tier-combo;
                        model: ["提醒: 全部", "提醒: 仅关键事件", "提醒: 静音(记日志)"];
                        current-index: root.reminder-tier;
                        changed current-index => {
                            root.reminder-tier = self.current-index;
                            root.reminder-tier-changed(self.current-index);
                        }
                    }
                }

                // ---- 符文 Tab: 选人与符文面板(原独立符文窗) ----
                if root.output-tab == 0 : RunesPanel {
                    vertical-stretch: 1;
                    champion-id: root.champion-id;
                    champion-name: root.champion-name;
                    champion-avatar: root.champion-avatar;
                    has-champion: root.has-champion;
                    runes: root.runes;
                    rune-status: root.rune-status;
                    apply-rune-status: root.apply-rune-status;
                    position-label: root.position-label;
                    auto-apply-enabled <=> root.auto-apply-enabled;
                    auto-builds-enabled <=> root.auto-builds-enabled;
                    counter-available: root.counter-available;
                    counter-summary: root.counter-summary;
                    counter-status: root.counter-status;
                    opponent-header: root.opponent-header;
                    opponent-intel: root.opponent-intel;
                    war-header: root.war-header;
                    war-body: root.war-body;
                    rune-compare-header: root.rune-compare-header;
                    rune-compare-body: root.rune-compare-body;
                    roster-my: root.roster-my;
                    roster-enemy: root.roster-enemy;
                    counter-cand-ids: root.counter-cand-ids;
                    counter-cand-names: root.counter-cand-names;
                    apply-rune-clicked(index) => {
                        root.apply-rune-clicked(index);
                    }
                    apply-best-rune-clicked() => {
                        root.apply-best-rune-clicked();
                    }
                    apply-counter-rune-clicked() => {
                        root.apply-counter-rune-clicked();
                    }
                    auto-apply-toggled(enabled) => {
                        root.auto-apply-toggled(enabled);
                    }
                    auto-builds-toggled(enabled) => {
                        root.auto-builds-toggled(enabled);
                    }
                    counter-pick-opponent(cid) => {
                        root.counter-pick-opponent(cid);
                    }
                }

                // ---- 对局数据 / 大师对话: 共用同一个文本缓冲区 ----
                if root.output-tab != 0 : Text {
                    text: root.output-tab == 1
                        ? "勾选后: 每局进场在另一块屏弹 340×220 置顶小窗(比分/资源/出装,2.5s 刷一次); 弹完焦点立刻还给游戏, 永不落在游戏屏; 只有一块屏时不弹。"
                        : "大师的输出与你的提问都在这一个框里; 手动切 Tab 后 45 秒内不会被对局快照抢走。";
                    font-size: Tokens.f-mini;
                    color: Tokens.c-text-faint;
                    wrap: word-wrap;
                }

                if root.output-tab != 0 : TextEdit {
                    text: root.output-tab == 1
                        ? (root.live-match-text != "" ? root.live-match-text : "等待对局数据(进入英雄选择或对局后自动刷新)")
                        : (root.coach-chat-log != "" ? root.coach-chat-log : "还没有对话。向大师提问试试。");
                    read-only: true;
                    min-height: 220px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    font-size: Tokens.f-aux;
                }

                if root.output-tab == 2 : LineEdit {
                    text: root.coach-input;
                    placeholder-text: "向大师提问, 回车发送…";
                    horizontal-stretch: 1;
                    edited(text) => {
                        root.coach-input = text;
                        // 打字期间持续续期, 对局快照不抢台
                        root.output-tab-hold();
                    }
                    accepted => {
                        root.coach-send-clicked();
                    }
                }

                if root.coach-busy : Text {
                    text: "大师思考中…";
                    font-size: Tokens.f-aux;
                    color: Tokens.c-muted;
                }
            }
        }

        // 底部一行: 左边构建戳(排查"改了没生效"), 右边设置入口。
        // 用户 2026-10-03 拍板: 只为装一个按钮的"快捷操作"卡片整张删掉。
        HorizontalLayout {
            alignment: center;
            spacing: Tokens.s-sm;

            Text {
                text: "构建 " + root.build-stamp;
                font-size: Tokens.f-mini;
                color: Tokens.c-text-faint;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 1px;
            }
            GoldButton {
                text: "⚙ 设置";
                width: 108px;
                clicked => {
                    root.open-tts-settings-clicked();
                }
            }
        }

    }
}
export component TtsSettingsWindow inherits Window {
    default-font-family: Tokens.font-family;
    icon: @image-url("icons/champr.png");
    title: "设置";
    preferred-width: Tokens.win-settings-w;
    preferred-height: Tokens.win-settings-h;
    min-width: Tokens.win-settings-min-w;
    min-height: Tokens.win-settings-min-h;
    background: Tokens.c-page;

    in-out property <int> tts-rate: 0;
    in-out property <int> tts-volume: 100;
    in-out property <string> tts-voice: "zh-CN-XiaoxiaoNeural";
    in-out property <string> tts-test-text: "";
    in-out property <string> tts-test-status: "";
    in-out property <string> lol-launcher-path: "";
    // 排队就绪自动接受对局(用户 2026-09-30 拍板默认开, 可在设置关)
    in-out property <bool> auto-accept-match: true;
    in-out property <string> deepseek-api-key: "";
    in-out property <string> deepseek-base-url: "";
    in-out property <string> deepseek-model: "";
    in-out property <bool> deepseek-thinking: false;
    in-out property <bool> deepseek-stream: false;
    in-out property <string> deepseek-reasoning-effort: "";
    in-out property <string> ai-provider: "deepseek";
    // LLM 通道: maohou 引擎子进程(默认) / direct 直连; maohou-status 启动时检测报告
    in-out property <string> ai-backend: "maohou";
    in-out property <string> maohou-bin: "";
    in-out property <string> maohou-status: "";
    in-out property <bool> deepseek-web-risk-accepted: false;
    in-out property <string> deepseek-web-status: "未启动";
    in-out property <string> lmstudio-base-url: "http://localhost:1234/v1";
    in-out property <string> lmstudio-model: "local-model";
    in-out property <string> lmstudio-api-key: "";
    // 任意 OpenAI 兼容端点(第三方网关/本地推理站; Claude/Anthropic 不走这里)
    in-out property <string> openai-base-url: "";
    in-out property <string> openai-model: "";
    in-out property <string> openai-api-key: "";
    // 显示器固定: 0 = 不固定, 显示索引从 1 起(由 Rust 启动时装填)
    in-out property <[string]> monitor-options: [];
    in-out property <int> pinned-monitor: 0;

    callback apply-clicked();
    callback cancel-clicked();
    callback test-tts-clicked();
    callback open-speech-settings-clicked();
    callback open-deepseek-web-login-clicked();

    VerticalLayout {
        padding: Tokens.s-lg;
        spacing: Tokens.s-md;

        Text {
            text: "设置";
            font-size: Tokens.f-title;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // 内容超出一屏时滚动; 底部 应用/取消 永远钉在视口内。
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Tokens.s-md;
                padding-right: Tokens.s-sm;
        Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-card-border;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Tokens.s-md;
                spacing: Tokens.s-sm;
                Text { text: "TTS"; font-size: Tokens.f-section; font-weight: 600; }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "语速"; width: Tokens.w-form-label; vertical-alignment: center; }
                    SpinBox { minimum: -10; maximum: 10; value: root.tts-rate; horizontal-stretch: 1; edited(value) => { root.tts-rate = value; } }
                }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "音量"; width: Tokens.w-form-label; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 100; value: root.tts-volume; horizontal-stretch: 1; edited(value) => { root.tts-volume = value; } }
                }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "音色"; width: Tokens.w-form-label; vertical-alignment: center; }
                    LineEdit { text: root.tts-voice; horizontal-stretch: 1; edited(text) => { root.tts-voice = text; } }
                }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    LineEdit { text: root.tts-test-text; placeholder-text: "输入测试文字"; horizontal-stretch: 1; edited(text) => { root.tts-test-text = text; } }
                    GoldButton { text: "🔊 试听"; clicked => { root.test-tts-clicked(); } }
                }
                if root.tts-test-status != "" : TextEdit {
                    text: root.tts-test-status;
                    font-size: Tokens.f-aux;
                    read-only: true;
                }
                GoldButton {
                    text: "打开语音设置";
                    horizontal-stretch: 1;
                    clicked => {
                        root.open-speech-settings-clicked();
                    }
                }
            }
        }

        Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-card-border;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Tokens.s-md;
                spacing: Tokens.s-sm;
                Text { text: "对局"; font-size: Tokens.f-section; font-weight: 600; }
                GoldCheck {
                    text: "排队就绪时自动点\"接受对局\"";
                    checked: root.auto-accept-match;
                    toggled => { root.auto-accept-match = self.checked; }
                }
                Text {
                    text: "对局中找到后自动接受, 不用再守客户端; 只影响你自己, 每局最多触发一次; 可随时关闭。";
                    font-size: Tokens.f-mini;
                    color: Tokens.c-text-faint;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-card-border;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Tokens.s-md;
                spacing: Tokens.s-sm;
                Text { text: "显示器定位"; font-size: Tokens.f-section; font-weight: 600; }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "固定到屏幕"; width: Tokens.w-form-label; vertical-alignment: center; }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.monitor-options;
                        current-index: root.pinned-monitor;
                        changed current-index => {
                            root.pinned-monitor = self.current-index;
                        }
                    }
                }
                Text {
                    text: "选定后所有窗口都出现在该屏, 不与游戏主屏抢占; 插拔显示器后需重启本程序。";
                    font-size: Tokens.f-mini;
                    color: Tokens.c-text-faint;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-card-border;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Tokens.s-md;
                spacing: Tokens.s-sm;
                Text { text: "LoL"; font-size: Tokens.f-section; font-weight: 600; }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "启动器路径"; width: Tokens.w-form-label; vertical-alignment: center; }
                    LineEdit { text: root.lol-launcher-path; horizontal-stretch: 1; edited(text) => { root.lol-launcher-path = text; } }
                }
            }
        }

        Rectangle {
            background: Tokens.c-card;
            border-radius: Tokens.radius;
            border-width: Tokens.border-hair;
            border-color: Tokens.c-card-border;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Tokens.s-md;
                spacing: Tokens.s-sm;
                Text { text: "DeepSeek"; font-size: Tokens.f-section; font-weight: 600; }
                HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "提供商"; width: Tokens.w-form-label; vertical-alignment: center; }
                    ComboBox {
                        model: ["deepseek", "deepseek_web", "lmstudio", "openai"];
                        current-value: root.ai-provider;
                        selected(value) => {
                            root.ai-provider = value;
                        }
                    }
                }
                if root.ai-provider != "deepseek_web" : VerticalLayout {
                    spacing: Tokens.s-sm;
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "LLM 通道"; width: Tokens.w-form-label; vertical-alignment: center; }
                        ComboBox {
                            model: ["maohou", "direct"];
                            current-value: root.ai-backend;
                            selected(value) => { root.ai-backend = value; }
                        }
                    }
                    Text {
                        text: root.maohou-status;
                        color: Tokens.c-text-secondary;
                        font-size: Tokens.f-aux;
                        wrap: word-wrap;
                    }
                    if root.ai-backend == "maohou" : HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "引擎路径"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { placeholder-text: "留空 = 自动(MAOHOU_BIN → 兄弟仓 → PATH)"; text: root.maohou-bin; horizontal-stretch: 1; edited(text) => { root.maohou-bin = text; } }
                    }
                    if root.ai-backend == "maohou" : Text {
                        text: "引擎模式暂不支持: 思维链 / 推理强度 / 流式输出 —— 这些开关在引擎模式不生效; 带回请在 houmao-mac/engine 侧补齐后再启用。";
                        color: Tokens.c-text-secondary;
                        font-size: Tokens.f-aux;
                        wrap: word-wrap;
                    }
                }
                if root.ai-provider == "deepseek_web" : VerticalLayout {
                    spacing: Tokens.s-sm;
                    Text {
