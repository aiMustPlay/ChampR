                        wrap: word-wrap;
                    }
                    GoldCheck {
                        text: "我了解网页自动化的账号与服务条款风险";
                        checked: root.deepseek-web-risk-accepted;
                        toggled => { root.deepseek-web-risk-accepted = !root.deepseek-web-risk-accepted; }
                    }
                    GoldButton {
                        text: "打开 DeepSeek 登录窗口";
                        enabled: root.deepseek-web-risk-accepted;
                        clicked => { root.open-deepseek-web-login-clicked(); }
                    }
                    Text { text: root.deepseek-web-status; color: Tokens.c-text-secondary; wrap: word-wrap; }
                }
                if root.ai-provider == "deepseek" : VerticalLayout {
                    spacing: Tokens.s-sm;
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "API Key"; width: Tokens.w-form-label; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-api-key; horizontal-stretch: 1; edited(text) => { root.deepseek-api-key = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "Base URL"; width: Tokens.w-form-label; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-base-url; horizontal-stretch: 1; edited(text) => { root.deepseek-base-url = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "模型"; width: Tokens.w-form-label; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-model; horizontal-stretch: 1; edited(text) => { root.deepseek-model = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-height; spacing: Tokens.s-md;
                    Text { text: "思维链"; width: Tokens.w-form-label; vertical-alignment: center; }
                    GoldCheck { checked: root.deepseek-thinking; toggled => { root.deepseek-thinking = !root.deepseek-thinking; } }
                    }
                    HorizontalLayout { height: Tokens.row-height; spacing: Tokens.s-md;
                    Text { text: "流式输出"; width: Tokens.w-form-label; vertical-alignment: center; }
                    GoldCheck { checked: root.deepseek-stream; toggled => { root.deepseek-stream = !root.deepseek-stream; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                    Text { text: "推理强度"; width: Tokens.w-form-label; vertical-alignment: center; }
                    LineEdit { text: root.deepseek-reasoning-effort; horizontal-stretch: 1; edited(text) => { root.deepseek-reasoning-effort = text; } }
                    }
                }
                if root.ai-provider == "lmstudio" : VerticalLayout {
                    spacing: Tokens.s-sm;
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "Base URL"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { text: root.lmstudio-base-url; horizontal-stretch: 1; edited(text) => { root.lmstudio-base-url = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "模型"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { text: root.lmstudio-model; horizontal-stretch: 1; edited(text) => { root.lmstudio-model = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "API Key"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { text: root.lmstudio-api-key; horizontal-stretch: 1; edited(text) => { root.lmstudio-api-key = text; } }
                    }
                }
                if root.ai-provider == "openai" : VerticalLayout {
                    spacing: Tokens.s-sm;
                    Text {
                        text: "任意 OpenAI 兼容端点(第三方网关/本地推理站; Claude 不需要走这里)。API Key 可留空。";
                        color: Tokens.c-text-secondary;
                        font-size: Tokens.f-aux;
                        wrap: word-wrap;
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "Base URL"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { placeholder-text: "https://你的网关/v1"; text: root.openai-base-url; horizontal-stretch: 1; edited(text) => { root.openai-base-url = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "模型"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { text: root.openai-model; horizontal-stretch: 1; edited(text) => { root.openai-model = text; } }
                    }
                    HorizontalLayout { height: Tokens.row-field; spacing: Tokens.s-md;
                        Text { text: "API Key"; width: Tokens.w-form-label; vertical-alignment: center; }
                        LineEdit { text: root.openai-api-key; horizontal-stretch: 1; edited(text) => { root.openai-api-key = text; } }
                    }
                }
            }
        }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: Tokens.s-md;
            GoldButton { text: "取消"; clicked => { root.cancel-clicked(); } }
            GoldButton { text: "应用"; primary: true; clicked => { root.apply-clicked(); } }
        }
    }
}

// ---------------------------------------------------------------------------
//  MiniMatchWindow——对局中的置顶迷你窗(取代 overlay 大窗等非我们能力项)
//  尺寸参照桌面助手通行规格 340x220, 只露对局摘要, 关闭后本局不重弹。
// ---------------------------------------------------------------------------
export component MiniMatchWindow inherits Window {
    default-font-family: Tokens.font-family;
    icon: @image-url("icons/champr.png");
    title: "对局摘要";
    width: Tokens.win-mini-w;
    height: Tokens.win-mini-h;
    always-on-top: true;
    // 对局中置顶显示, 与游戏全屏/无边框模式共存: 深金配色不刺眼
    background: Tokens.c-page;

    in-out property <string> match-text: "";
    in-out property <string> match-status: "对局中";

    VerticalLayout {
        padding: Tokens.s-md;
        spacing: Tokens.s-sm;

        HorizontalLayout {
            spacing: Tokens.s-sm;
            alignment: center;
            height: Tokens.row-height;

            Rectangle {
                width: Tokens.status-dot;
                height: Tokens.status-dot;
                border-radius: Tokens.status-dot / 2;
                background: Tokens.c-ok;
            }
            Text {
                text: root.match-status;
                font-size: Tokens.f-aux;
                vertical-alignment: center;
                color: Tokens.c-gold;
            }
        }

        // TextEdit 不支持改前景色(跟随系统 Palette), 迷你窗用 Text + 换行
        Text {
            text: root.match-text;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            font-size: Tokens.f-aux;
            color: Tokens.c-text;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
}
